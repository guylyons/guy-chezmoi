#!/bin/sh
# Installs Homebrew (if missing) and everything in the Brewfile.
#
# chezmoi runs this automatically during `chezmoi apply`:
#   run_onchange_ = re-runs when this rendered script's contents change
#   before_       = runs BEFORE dotfiles are written, so tools exist
#                   before .zshrc tries to source them
#
# The Brewfile hash below is templated in so that ANY change to the
# Brewfile changes this script's rendered contents, which retriggers
# the install. (A plain run_once_ script never re-ran on Brewfile edits.)
#
# Brewfile hash: {{ include "Brewfile" | sha256sum }}
set -eu

# Debian/Ubuntu: Homebrew's build prerequisites, plus zsh itself.
# Running sudo here first also caches the password for the Homebrew installer below.
if [ "$(uname)" = Linux ] && command -v apt-get >/dev/null 2>&1; then
  sudo apt-get update
  sudo apt-get install -y build-essential procps curl file git zsh
fi

# Install Homebrew if it isn't already present.
if ! command -v brew >/dev/null 2>&1; then
  echo "Homebrew not found — installing..."
  NONINTERACTIVE=1 /bin/bash -c \
    "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

  # Add brew to PATH for the rest of this script (Apple Silicon, Intel, Linux).
  for b in /opt/homebrew/bin/brew /usr/local/bin/brew /home/linuxbrew/.linuxbrew/bin/brew; do
    [ -x "$b" ] && eval "$("$b" shellenv)" && break
  done
fi

echo "Installing packages from Brewfile..."
# chezmoi sets CHEZMOI_SOURCE_DIR when running scripts.
brew bundle --file="${CHEZMOI_SOURCE_DIR}/Brewfile"
